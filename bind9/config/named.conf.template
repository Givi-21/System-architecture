acl "trusted" {
	192.168.20.0/24;
    localhost;
    192.168.1.0/24;
};

options {
	directory "/var/cache/bind/";

	listen-on-v6 { any; };
	listen-on port 53 { any; };

	allow-query { trusted; };
    recursion yes;
    allow-recursion { "trusted"; };

	# settings up outside dns servers
	forwarders {
		192.168.20.1;
		8.8.8.8;
		8.8.4.4;
	};
}; 

zone "homelab.lan" {
  type master;
  file "/etc/bind/zones/db.homelab.lan";  
};

zone "__REV_SUBNET__.in-addr.arpa" {
  type master;
  file "/etc/bind/zones/db.192.168.20.15";  
};

